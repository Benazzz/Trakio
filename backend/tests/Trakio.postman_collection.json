                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON atsakymas\", () => pm.response.to.be.json);",
                  "pm.test(\"Turi data, page, limit, total\", () => { const j = pm.response.json(); pm.expect(j.data).to.be.an(\"array\"); pm.expect(j).to.have.keys(\"data\",\"page\",\"limit\",\"total\"); });",
                  "pm.test(\"Elementai turi _links\", () => pm.expect(pm.response.json().data[0]._links.self.href).to.match(/^\\/games\\/\\d+$/));"
